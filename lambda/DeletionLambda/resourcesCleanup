# ---------- SQS Queues ----------

def delete_sqs_queues(session, region):
    sqs = session.client('sqs', region_name=region)
    try:
        response = sqs.list_queues()
        queue_urls = response.get('QueueUrls', [])
        for queue_url in queue_urls:
            try:
                sqs.delete_queue(QueueUrl=queue_url)
                logger.info(f"Deleted SQS queue {queue_url} in {region}")
            except Exception as e:
                logger.error(f"Error deleting SQS queue {queue_url} in {region}: {e}")
    except Exception as e:
        logger.error(f"Error listing SQS queues in {region}: {e}")

# ---------- Remove Member Account from Organization ----------

def remove_member_account(session, account_id):
    """
    Remove the account from the AWS Organization.
    Note: This disassociates the account but does not completely 'delete' it.
    """
    org_client = session.client('organizations')
    try:
        response = org_client.remove_account_from_organization(AccountId=account_id)
        logger.info(f"Removed account {account_id} from organization: {response}")
    except Exception as e:
        logger.error(f"Error removing account {account_id}: {e}")
        raise
